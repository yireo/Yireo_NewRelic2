{
    "name": "yireo/magento2-newrelic2",
    "license": "BSD-2-Clause",
    "type": "magento2-module",
    "version": "0.3.5",
    "homepage": "https://www.yireo.com/software/magento-extensions/newrelic",
    "description": "Add NewRelic JS support and PHP tracking to Magento",
    "keywords": [
        "composer-installer",
        "magento"
    ],
    "authors": [
        {
            "name": "Jisse Reitsma (Yireo)",
            "email": "jisse@yireo.com"
        }
    ],
    "require": {
        "magento/framework": "^101.0|^102.0|^103.0",
        "magento/module-backend": "^102.0",
        "magento/module-config": "^101.2",
        "magento/module-customer": "^103.0",
        "magento/module-store": "^101.1",
        "php": ">=8.2 <8.6",
        "psr/log": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "magento/module-catalog": "^104.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Yireo\\NewRelic2\\": ""
        },
        "files": [
            "registration.php"
        ]
    }
}
